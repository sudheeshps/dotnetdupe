<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DotNetDupe_props_imported>true</DotNetDupe_props_imported>
    <DotNetDupe_Platform Condition="'$(Platform)' == 'Win32'">win-x86</DotNetDupe_Platform>
    <DotNetDupe_Platform Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'AnyCPU'">win-x64</DotNetDupe_Platform>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\..\include\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Windows Implementation -->
  <ItemDefinitionGroup Condition="'$(OS)' == 'Windows_NT'">
    <Link>
      <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)..\..\runtimes\$(DotNetDupe_Platform)\native\;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>DotNetDupe.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- Inject Natvis Visualizer into Consumer Projects -->
  <ItemGroup>
    <Natvis Include="$(MSBuildThisFileDirectory)DotNetDupe.natvis" />
  </ItemGroup>

  <!-- Copy DLLs and PDBs to output for Windows -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\$(DotNetDupe_Platform)\native\DotNetDupe.dll" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\$(DotNetDupe_Platform)\native\DotNetDupe.pdb" Condition="Exists('$(MSBuildThisFileDirectory)..\..\runtimes\$(DotNetDupe_Platform)\native\DotNetDupe.pdb')" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\$(DotNetDupe_Platform)\native\libssl*.dll" />
    <ReferenceCopyLocalPaths Include="$(MSBuildThisFileDirectory)..\..\runtimes\$(DotNetDupe_Platform)\native\libcrypto*.dll" />
  </ItemGroup>

  <!-- Linux/iOS support for MSBuild (e.g. via .NET MAUI or mono) would go here -->
  <!-- Note: Most Linux/iOS consumers would use CMake, which doesn't use .targets files directly. -->
</Project>
