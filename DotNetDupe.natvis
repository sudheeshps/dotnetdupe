<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <!-- ======================================================= -->
  <!-- Core System Types                                       -->
  <!-- ======================================================= -->

  <!-- DotNetDupe::System::String (Pimpl casting to known std::string) -->
  <Type Name="DotNetDupe::System::String">
    <DisplayString Condition="m_pImpl == 0">&lt;null&gt;</DisplayString>
    <DisplayString>{*(std::string*)m_pImpl}</DisplayString>
    <StringView>*(std::string*)m_pImpl</StringView>
    <Expand>
      <Item Name="Value">*(std::string*)m_pImpl</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::SmartPointer<T> -->
  <Type Name="DotNetDupe::System::SmartPointer&lt;*&gt;">
    <DisplayString Condition="m_pObject == 0">&lt;null&gt;</DisplayString>
    <DisplayString>{*m_pObject}</DisplayString>
    <Expand>
      <Item Name="[Target]">m_pObject</Item>
      <Item Name="[RefCount]" Condition="m_pnRefCount != 0">*m_pnRefCount</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::EventArgs -->
  <Type Name="DotNetDupe::System::EventArgs">
    <DisplayString>{{ EventArgs }}</DisplayString>
  </Type>

  <!-- DotNetDupe::System::EventHandler<T> -->
  <Type Name="DotNetDupe::System::EventHandler&lt;*&gt;">
    <DisplayString>{{ subscribers={m_lstSubscribers.m_iCount} }}</DisplayString>
    <Expand>
      <Item Name="[SubscriberCount]">m_lstSubscribers.m_iCount</Item>
      <Item Name="[Subscribers]">m_lstSubscribers</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Array<T> -->
  <Type Name="DotNetDupe::System::Array&lt;*&gt;">
    <DisplayString>{{ size={m_iLength} }}</DisplayString>
    <Expand>
      <Item Name="[Length]">m_iLength</Item>
      <ArrayItems>
        <Size>m_iLength</Size>
        <ValuePointer>m_pData</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Collections::Generic::List<T> -->
  <Type Name="DotNetDupe::System::Collections::Generic::List&lt;*&gt;">
    <DisplayString>{{ size={m_iCount} }}</DisplayString>
    <Expand>
      <Item Name="[Count]">m_iCount</Item>
      <Item Name="[Capacity]">m_iCapacity</Item>
      <ArrayItems>
        <Size>m_iCount</Size>
        <ValuePointer>m_pData</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Collections::Generic::KeyValuePair<TKey, TValue> -->
  <Type Name="DotNetDupe::System::Collections::Generic::KeyValuePair&lt;*,*&gt;">
    <DisplayString>[{Key}, {Value}]</DisplayString>
    <Expand>
      <Item Name="Key">Key</Item>
      <Item Name="Value">Value</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Collections::Concurrent::ConcurrentQueue<T> -->
  <Type Name="DotNetDupe::System::Collections::Concurrent::ConcurrentQueue&lt;*&gt;">
    <DisplayString>{{ size={m_list.m_iCount} }}</DisplayString>
    <Expand>
      <Item Name="[Count]">m_list.m_iCount</Item>
      <ExpandedItem>m_list</ExpandedItem>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Collections::Concurrent::ConcurrentStack<T> -->
  <Type Name="DotNetDupe::System::Collections::Concurrent::ConcurrentStack&lt;*&gt;">
    <DisplayString>{{ size={m_list.m_iCount} }}</DisplayString>
    <Expand>
      <Item Name="[Count]">m_list.m_iCount</Item>
      <ExpandedItem>m_list</ExpandedItem>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Collections::Concurrent::ConcurrentBag<T> -->
  <Type Name="DotNetDupe::System::Collections::Concurrent::ConcurrentBag&lt;*&gt;">
    <DisplayString>{{ size={m_list.m_iCount} }}</DisplayString>
    <Expand>
      <Item Name="[Count]">m_list.m_iCount</Item>
      <ExpandedItem>m_list</ExpandedItem>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Collections::Concurrent::BlockingCollection<T> -->
  <Type Name="DotNetDupe::System::Collections::Concurrent::BlockingCollection&lt;*&gt;">
    <DisplayString>{{ size={m_list.m_iCount}, boundedCapacity={m_iBoundedCapacity}, completed={m_bIsAddingCompleted} }}</DisplayString>
    <Expand>
      <Item Name="[Count]">m_list.m_iCount</Item>
      <Item Name="[BoundedCapacity]">m_iBoundedCapacity</Item>
      <Item Name="[IsAddingCompleted]">m_bIsAddingCompleted</Item>
      <ExpandedItem>m_list</ExpandedItem>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Collections::Concurrent::ConcurrentDictionary<TKey, TValue> -->
  <Type Name="DotNetDupe::System::Collections::Concurrent::ConcurrentDictionary&lt;*,*&gt;">
    <DisplayString>{{ size={m_dict.m_iCount} }}</DisplayString>
    <Expand>
      <Item Name="[Count]">m_dict.m_iCount</Item>
      <ExpandedItem>m_dict</ExpandedItem>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Text::StringBuilder (Pimpl casting to known std::string) -->
  <Type Name="DotNetDupe::System::Text::StringBuilder">
    <DisplayString Condition="m_pImpl == 0">&lt;null&gt;</DisplayString>
    <DisplayString>{*(std::string*)m_pImpl}</DisplayString>
    <StringView>*(std::string*)m_pImpl</StringView>
    <Expand>
      <Item Name="Value">*(std::string*)m_pImpl</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::DateTimeOffset -->
  <Type Name="DotNetDupe::System::DateTimeOffset">
    <DisplayString>Ticks={_ticks}</DisplayString>
    <Expand>
      <Item Name="Ticks">_ticks</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::TimeSpan -->
  <Type Name="DotNetDupe::System::TimeSpan">
    <DisplayString>Ticks={_ticks}</DisplayString>
    <Expand>
      <Item Name="Ticks">_ticks</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Guid -->
  <Type Name="DotNetDupe::System::Guid">
    <DisplayString>{_guidStr}</DisplayString>
  </Type>

  <!-- DotNetDupe::System::Version -->
  <Type Name="DotNetDupe::System::Version">
    <DisplayString>{_major}.{_minor}.{_build}.{_revision}</DisplayString>
    <Expand>
      <Item Name="Major">_major</Item>
      <Item Name="Minor">_minor</Item>
      <Item Name="Build">_build</Item>
      <Item Name="Revision">_revision</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Diagnostics::EtwEvent -->
  <Type Name="DotNetDupe::System::Diagnostics::EtwEvent">
    <DisplayString>[ID={iEventId}, Level={iLevel}] Provider={sProviderName}</DisplayString>
    <Expand>
      <Item Name="EventId">iEventId</Item>
      <Item Name="Level">iLevel</Item>
      <Item Name="ProviderName">sProviderName</Item>
      <Item Name="ChannelName">sChannelName</Item>
      <Item Name="TimeCreated">dtTimeCreated</Item>
      <Item Name="Message">sMessage</Item>
      <Item Name="RawXml">sRawXml</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Net::WebSockets::WebSocketException -->
  <Type Name="DotNetDupe::System::Net::WebSockets::WebSocketException">
    <DisplayString>[WebSocketError={m_eWebSocketErrorCode}] {what()}</DisplayString>
    <Expand>
      <Item Name="WebSocketError">m_eWebSocketErrorCode</Item>
      <Item Name="NativeErrorCode">m_iNativeErrorCode</Item>
      <Item Name="Message">what()</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Net::WebSockets::WebSocket -->
  <Type Name="DotNetDupe::System::Net::WebSockets::WebSocket">
    <DisplayString Condition="m_pImpl == 0">&lt;null&gt;</DisplayString>
    <DisplayString>WebSocket [State={m_pImpl-&gt;m_eState}]</DisplayString>
    <Expand>
      <Item Name="State">m_pImpl-&gt;m_eState</Item>
      <Item Name="Stream">m_pImpl-&gt;m_pStream</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Diagnostics::NetworkConnectionInfo -->
  <Type Name="DotNetDupe::System::Diagnostics::NetworkConnectionInfo">
    <DisplayString>[{sState}] {sLocalAddress}:{iLocalPort} -&gt; {sRemoteAddress}:{iRemotePort}</DisplayString>
    <Expand>
      <Item Name="LocalAddress">sLocalAddress</Item>
      <Item Name="LocalPort">iLocalPort</Item>
      <Item Name="RemoteAddress">sRemoteAddress</Item>
      <Item Name="RemotePort">iRemotePort</Item>
      <Item Name="State">sState</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Diagnostics::ProcessNetworkConnectionInfo -->
  <Type Name="DotNetDupe::System::Diagnostics::ProcessNetworkConnectionInfo">
    <DisplayString>Ports={lstOpenPorts.m_iCount}, Connections={lstConnections.m_iCount}, Established={bHasEstablishedInboundConnection}</DisplayString>
    <Expand>
      <Item Name="OpenPorts">lstOpenPorts</Item>
      <Item Name="Connections">lstConnections</Item>
      <Item Name="HasEstablishedInbound">bHasEstablishedInboundConnection</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Diagnostics::ProcessInfo -->
  <Type Name="DotNetDupe::System::Diagnostics::ProcessInfo">
    <DisplayString>[PID={iProcessId}] {sName} (Ports={lstOpenPorts.m_iCount}, Estab={bHasEstablishedConnection})</DisplayString>
    <Expand>
      <Item Name="ProcessId">iProcessId</Item>
      <Item Name="SessionId">iSessionId</Item>
      <Item Name="Name">sName</Item>
      <Item Name="Path">sPath</Item>
      <Item Name="CommandLine">sCommandLine</Item>
      <Item Name="CpuUsagePercent">dCpuUsagePercent</Item>
      <Item Name="Memory">memory</Item>
      <Item Name="Disk">disk</Item>
      <Item Name="Network">network</Item>
      <Item Name="OpenPorts">lstOpenPorts</Item>
      <Item Name="Connections">lstConnections</Item>
      <Item Name="HasEstablishedConnection">bHasEstablishedConnection</Item>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Diagnostics::ProcessStreamer -->
  <Type Name="DotNetDupe::System::Diagnostics::ProcessStreamer">
    <DisplayString Condition="m_pImpl == 0">&lt;null&gt;</DisplayString>
    <DisplayString>ProcessStreamer [Running={m_pImpl-&gt;m_bRunning}]</DisplayString>
    <Expand>
      <Item Name="Running">m_pImpl-&gt;m_bRunning</Item>
      <Item Name="Cancelled">m_pImpl-&gt;m_bCancelled</Item>
      <Item Name="BatchSize">m_pImpl-&gt;m_options.iBatchSize</Item>
      <Item Name="DetailLevel">m_pImpl-&gt;m_options.eDetailLevel</Item>
  <!-- DotNetDupe::System::Linq::Enumerable<T> -->
  <Type Name="DotNetDupe::System::Linq::Enumerable&lt;*&gt;">
    <DisplayString>{{ size={m_items.m_iCount} }}</DisplayString>
    <Expand>
      <Item Name="[Count]">m_items.m_iCount</Item>
      <ArrayItems>
        <Size>m_items.m_iCount</Size>
        <ValuePointer>m_items.m_pData</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Linq::OrderedEnumerable<T> -->
  <Type Name="DotNetDupe::System::Linq::OrderedEnumerable&lt;*&gt;">
    <DisplayString>{{ sorted_size={m_items.m_iCount} }}</DisplayString>
    <Expand>
      <Item Name="[Count]">m_items.m_iCount</Item>
      <ArrayItems>
        <Size>m_items.m_iCount</Size>
        <ValuePointer>m_items.m_pData</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Linq::IGrouping<TKey, TElement> -->
  <Type Name="DotNetDupe::System::Linq::IGrouping&lt;*,*&gt;">
    <DisplayString>{{ Key={m_key}, Count={m_elements.m_iCount} }}</DisplayString>
    <Expand>
      <Item Name="[Key]">m_key</Item>
      <Item Name="[Count]">m_elements.m_iCount</Item>
      <ArrayItems>
        <Size>m_elements.m_iCount</Size>
        <ValuePointer>m_elements.m_pData</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- DotNetDupe::System::Text::Json::JsonElement -->
  <Type Name="DotNetDupe::System::Text::Json::JsonElement">
    <DisplayString Condition="m_pImpl.m_pObject == 0">&lt;null&gt;</DisplayString>
    <DisplayString Condition="m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::String">{m_pImpl.m_pObject-&gt;sStrValue}</DisplayString>
    <DisplayString Condition="m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::Number">{m_pImpl.m_pObject-&gt;dNumValue}</DisplayString>
    <DisplayString Condition="m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::True">true</DisplayString>
    <DisplayString Condition="m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::False">false</DisplayString>
    <DisplayString Condition="m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::Null">null</DisplayString>
    <DisplayString Condition="m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::Array">{{ array, size={m_pImpl.m_pObject-&gt;lstArray.m_iCount} }}</DisplayString>
    <DisplayString Condition="m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::Object">{{ object, size={m_pImpl.m_pObject-&gt;dictObject.m_iCount} }}</DisplayString>
    <DisplayString Condition="m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::Undefined">undefined</DisplayString>
    <Expand>
      <Item Name="[Kind]" Condition="m_pImpl.m_pObject != 0">m_pImpl.m_pObject-&gt;eKind</Item>
      <Item Name="[Value]" Condition="m_pImpl.m_pObject != 0 &amp;&amp; m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::String">m_pImpl.m_pObject-&gt;sStrValue</Item>
      <Item Name="[Value]" Condition="m_pImpl.m_pObject != 0 &amp;&amp; m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::Number">m_pImpl.m_pObject-&gt;dNumValue</Item>
      <Item Name="[Array]" Condition="m_pImpl.m_pObject != 0 &amp;&amp; m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::Array">m_pImpl.m_pObject-&gt;lstArray</Item>
      <Item Name="[Object]" Condition="m_pImpl.m_pObject != 0 &amp;&amp; m_pImpl.m_pObject-&gt;eKind == DotNetDupe::System::Text::Json::JsonValueKind::Object">m_pImpl.m_pObject-&gt;dictObject</Item>
    </Expand>
  </Type>

</AutoVisualizer>
