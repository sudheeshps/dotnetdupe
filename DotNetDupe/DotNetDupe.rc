// Resource script for DotNetDupe.dll
#include <windows.h>

#define VER_FILEVERSION             3,0,2,0
#define VER_FILEVERSION_STR         "3.0.2.0\0"

#define VER_PRODUCTVERSION          3,0,2,0
#define VER_PRODUCTVERSION_STR      "3.0.2\0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION        VER_FILEVERSION
PRODUCTVERSION     VER_PRODUCTVERSION
FILEFLAGSMASK      VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS          VS_FF_DEBUG
#else
FILEFLAGS          0x0L
#endif
FILEOS             VOS_NT_WINDOWS32
FILETYPE           VFT_DLL
FILESUBTYPE        VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Sudheesh Subramanian\0"
            VALUE "FileDescription",  "DotNetDupe Core Library\0"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "DotNetDupe.dll\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Sudheesh Subramanian\0"
            VALUE "OriginalFilename", "DotNetDupe.dll\0"
            VALUE "ProductName",      "DotNetDupe\0"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
